generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE MODELS
// ============================================

model Shop {
  id              String   @id @default(cuid())
  name            String
  ownerName       String   @default("")
  mobile          String   @default("")
  email           String?
  address         String?
  city            String?
  state           String?
  gstNumber       String?
  
  // Activation
  activationKey   String   @unique @default("")
  isActivated     Boolean  @default(false)
  activatedAt     DateTime?
  
  // Branding
  primaryColor    String   @default("#1976d2")
  
  // Subscription
  planId          String?
  plan            Plan?    @relation(fields: [planId], references: [id])
  subscriptionStatus String @default("TRIAL") // TRIAL, ACTIVE, EXPIRED, SUSPENDED
  trialEndsAt     DateTime?
  subscriptionEndsAt DateTime?
  
  // Settings (stored as JSON for flexibility)
  settings        Json?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  customers       Customer[]
  orders          Order[]
  printers        Printer[]
  pricingRules    PricingRule[]
  orderFiles      OrderFile[]
  printJobs       PrintJob[]
  agents          Agent[]
  notifications   Notification[]
  whatsappSession WhatsAppSession?

  @@map("shops")
  @@index([activationKey])
  @@index([subscriptionStatus])
}

model Plan {
  id              String   @id @default(cuid())
  name            String   @unique // "Basic", "Pro", "Enterprise"
  priceMonthly   Int      @default(0) // in paise (₹999 = 99900)
  priceYearly    Int      @default(0)
  maxOrders      Int      @default(100) // per month
  maxPrinters    Int      @default(2)
  maxStaff       Int      @default(3)
  features       Json     @default("{}") // { whatsapp: true, analytics: true, api: false }
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  
  shops          Shop[]
}

model Agent {
  id              String   @id @default(cuid())
  shopId          String
  machineName     String   @default("COUNTER-1")
  machineId       String   @unique // UUID generated on install
  apiKey          String   @unique @default("")
  version         String   @default("1.0.0")
  isActive        Boolean  @default(true)
  lastHeartbeatAt DateTime?
  ipAddress       String?
  osInfo          String?
  createdAt       DateTime @default(now())
  
  shop            Shop     @relation(fields: [shopId], references: [id])
  
  @@index([shopId])
  @@index([machineId])
  @@index([apiKey])
}

model Notification {
  id              String   @id @default(cuid())
  shopId          String
  type            String   // order.new, printer.offline, payment.received, agent.disconnected
  title           String
  message         String
  data            Json?
  isRead          Boolean  @default(false)
  readAt          DateTime?
  createdAt       DateTime @default(now())
  
  shop            Shop     @relation(fields: [shopId], references: [id])
  
  @@index([shopId, isRead])
}

model WhatsAppSession {
  id              String   @id @default(cuid())
  shopId          String   @unique
  phoneNumber     String?
  isConnected     Boolean  @default(false)
  sessionData     Json?
  lastConnectedAt DateTime?
  createdAt       DateTime @default(now())
  
  shop            Shop     @relation(fields: [shopId], references: [id])
}

model Plan {
  id              String   @id @default(cuid())
  name            String   @unique // "Basic", "Pro", "Enterprise"
  priceMonthly   Int      @default(0) // in paise (₹999 = 99900)
  priceYearly    Int      @default(0)
  maxOrders      Int      @default(100) // per month
  maxPrinters    Int      @default(2)
  maxStaff       Int      @default(3)
  features       Json     @default("{}") // { whatsapp: true, analytics: true, api: false }
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  
  shops          Shop[]
}

model Agent {
  id              String   @id @default(cuid())
  shopId          String
  machineName     String   @default("COUNTER-1")
  machineId       String   @unique // UUID generated on install
  apiKey          String   @unique @default("")
  version         String   @default("1.0.0")
  isActive        Boolean  @default(true)
  lastHeartbeatAt DateTime?
  ipAddress       String?
  osInfo          String?
  createdAt       DateTime @default(now())
  
  shop            Shop     @relation(fields: [shopId], references: [id])
  
  @@index([shopId])
  @@index([machineId])
  @@index([apiKey])
}

model Notification {
  id              String   @id @default(cuid())
  shopId          String
  type            String   // order.new, printer.offline, payment.received, agent.disconnected
  title           String
  message         String
  data            Json?
  isRead          Boolean  @default(false)
  readAt          DateTime?
  createdAt       DateTime @default(now())
  
  shop            Shop     @relation(fields: [shopId], references: [id])
  
  @@index([shopId, isRead])
}

model WhatsAppSession {
  id              String   @id @default(cuid())
  shopId          String   @unique
  phoneNumber     String?
  isConnected     Boolean  @default(false)
  sessionData     Json?
  lastConnectedAt DateTime?
  createdAt       DateTime @default(now())
  
  shop            Shop     @relation(fields: [shopId], references: [id])
}

model User {
  id           String   @id @default(uuid())
  shopId       String
  email        String
  passwordHash String
  name         String
  role         String   @default("OPERATOR") // OWNER, MANAGER, OPERATOR, CUSTOMER
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id])

  @@unique([shopId, email])
  @@map("users")
}

model Customer {
  id        String   @id @default(uuid())
  shopId    String
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop   Shop    @relation(fields: [shopId], references: [id])
  orders Order[]

  @@map("customers")
}

model Order {
  id              String   @id @default(cuid())
  token           Int?
  customerId      String?
  shopId          String
  status          String   @default("PENDING") // PENDING, APPROVED, PRINTING, COMPLETED, CANCELLED, FAILED
  paymentStatus   String   @default("UNPAID")  // UNPAID, PAID, REFUNDED
  paymentMethod   String?  // cash, upi, card, online
  paymentRef      String?  // UPI ref, transaction ID
  subtotal        Float    @default(0)
  tax             Float    @default(0)
  discount        Float    @default(0)
  total           Float    @default(0)
  customerNotes   String?
  adminNotes      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  approvedAt      DateTime?
  printingAt      DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?

  shop            Shop        @relation(fields: [shopId], references: [id])
  customer        Customer?   @relation(fields: [customerId], references: [id])
  files           OrderFile[]
  printJobs       PrintJob[]

  @@unique([shopId, token])
  @@index([shopId, status])
  @@index([shopId, token])
  @@index([shopId, createdAt])
  @@map("orders")
}

model OrderFile {
  id            String   @id @default(uuid())
  orderId       String
  originalName  String
  storagePath   String
  fileType      String
  size          Int
  pageCount     Int      @default(0)
  colorPageCount Int     @default(0)
  orientation   String   @default("portrait")
  settings      Json?
  shopId        String

  order    Order      @relation(fields: [orderId], references: [id])
  shop     Shop       @relation(fields: [shopId], references: [id])
  printJobs PrintJob[]

  @@map("order_files")
}

model PrintJob {
  id              String   @id @default(cuid())
  orderId         String
  fileId          String
  printerId       String?
  sectionIndex    Int      @default(0)
  pages           String   // JSON array of page numbers
  colorMode       String   @default("bw")   // bw, color, auto
  printStyle      String   @default("single") // single, duplex
  paperSize       String   @default("A4")
  pagesPerSheet   Int      @default(1)
  flipDirection   String   @default("long-edge")
  copies          Int      @default(1)
  status          String   @default("PENDING") // PENDING, READY, DOWNLOADING, PRINTING, COMPLETED, FAILED, CANCELLED
  errorMessage    String?
  
  // Agent tracking
  downloadedAt    DateTime?
  printedAt       DateTime?
  agentMachineId  String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order           Order     @relation(fields: [orderId], references: [id])
  file            OrderFile @relation(fields: [fileId], references: [id])
  printer         Printer?  @relation(fields: [printerId], references: [id])
  shop            Shop      @relation(fields: [shopId], references: [id])

  @@index([orderId])
  @@index([shopId, status])
  @@index([printerId])
  @@map("print_jobs")
}

model Printer {
  id              String   @id @default(cuid())
  shopId          String
  name            String
  ip              String?
  port            Int      @default(9100)
  model           String?
  
  // Capabilities
  colorSupport    Boolean  @default(false)
  duplexSupport   Boolean  @default(false)
  paperSizes      Json     @default("[\"A4\"]")
  
  // Settings
  status          String   @default("ONLINE") // ONLINE, OFFLINE, PRINTING, ERROR, PAUSED, LOW_TONER
  isDefault       Boolean  @default(false)
  priority        Int      @default(0) // Higher = preferred
  
  // Counters
  totalPrints     Int      @default(0)
  totalPages      Int      @default(0)
  lastPrintAt     DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop            Shop      @relation(fields: [shopId], references: [id])
  printJobs       PrintJob[]

  @@index([shopId])
  @@index([status])
  @@map("printers")
}

model PricingRule {
  id              String   @id @default(uuid())
  name            String
  bwPerPage       Float    @default(1)   // ₹ per B&W page
  colorPerPage    Float    @default(5)   // ₹ per color page (single)
  colorDuplexPerPage Float @default(10)  // ₹ per color page (duplex)
  taxRate         Float    @default(18)
  shopId          String

  shop Shop @relation(fields: [shopId], references: [id])

  @@map("pricing_rules")
}
