{
  "name": "patel-autoprint-print-agent",
  "version": "2.0.0",
  "private": true,
  "description": "Windows Print Agent for Patel AutoPrint",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "build": "pkg src/index.js --targets node18-win-x64 --output dist/patel-print-agent.exe"
  },
  "dependencies": {
