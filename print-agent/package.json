    "winston": "^3.11.0",
    "auto-launch": "^5.0.6",
    "systeminformation": "^5.21.7",
    "node-schedule": "^2.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "pkg": "^5.8.1"
  }
}
